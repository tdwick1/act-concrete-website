# Copy to .env and set a long, unique password before using /admin.
ACT_ADMIN_PASSWORD=
# Resend API key and sender addresses on your verified domain.
RESEND_API_KEY=
RESEND_LEADS_FROM_EMAIL="ACT Concrete Leads <leads@actconcretewv.com>"
RESEND_QUOTES_FROM_EMAIL="ACT Concrete Quotes <quotes@actconcretewv.com>"
# Optional legacy fallback if either dedicated sender is not set.
RESEND_FROM_EMAIL=
# Where ACT Concrete should receive new lead alerts.
ACT_LEAD_EMAIL=
# Set this to your public HTTPS domain when deploying.
SITE_URL=
PORT=3000
# For deployment behind a reverse proxy, set HOST=0.0.0.0.
HOST=127.0.0.1
# Optional: set to the path of a persistent volume (for Railway, /data).
ACT_DATA_DIR=
